{
  "version": "2.0",
  "logging": {
    "logLevel": {
      "default": "Information",
      "Fcg.Notifications.Function": "Information",
      "Host.Results": "Information",
      "Host.Aggregator": "Warning"
    }
  },
  "retry": {
    "strategy": "exponentialBackoff",
    "maxRetryCount": 3,
    "minimumInterval": "00:00:02",
    "maximumInterval": "00:00:30"
  },
  "extensions": {
    "rabbitMQ": {
      "prefetchCount": 20
    }
  }
}
